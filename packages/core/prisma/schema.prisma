// Agents Space database (Supabase Postgres). Client is generated into src/generated/prisma.
// Domain types stay in src/schema.ts (zod); src/store/prisma.ts maps rows to them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentKind {
  hosted
  external
}

enum Visibility {
  public
  private
  listed
  restricted
}

enum AgentStatus {
  draft
  published
}

enum Protocol {
  mcp
  a2a
  api
  web
}

enum Pricing {
  free
  usage
  subscription
  contact
}

enum AccessStatus {
  pending
  approved
  denied
}

model User {
  id        String   @id @default(uuid())
  handle    String   @unique
  /// sha256 of the API key; the key itself is shown once and never stored. Null until one is generated.
  keyHash   String?  @unique
  /// Supabase Auth user id (auth.users.id) for people who signed in on the web (Google OAuth).
  authId    String?  @unique
  email     String?
  /// Stripe Connect (Express) account that receives this user's payments.
  stripeAccountId String? @unique
  createdAt DateTime @default(now())

  agents         Agent[]
  connectors     Connector[]
  accessRequests AccessRequest[]
  deviceLogins   DeviceLogin[]
  aiModels       AiModel[]
  tableRows      TableRow[]
  payments       Payment[]
}

model Agent {
  id           String      @id
  name         String
  tagline      String
  description  String
  solves       String[]
  tools        String[]
  category     String
  endpoint     String?
  protocol     Protocol    @default(mcp)
  owner        String
  pricing      Pricing     @default(free)
  kind         AgentKind   @default(external)
  visibility   Visibility  @default(public)
  status       AgentStatus @default(published)
  /// skill | scheduled (check constraint in the Supabase schema)
  mode         String      @default("skill")
  /// AiModel.name that runs it; null = platform default
  model        String?
  instructions String      @default("")
  createdAt    DateTime    @default(now())

  ownerId   String?
  ownerUser User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  notes          ContextNote[]
  connectors     AgentConnector[]
  accessRequests AccessRequest[]
  tables         AgentTable[]
  tableRows      TableRow[]
  schedules      AgentSchedule[]
  prices         Price[]
  payments       Payment[]
  modelRef       AiModel?        @relation(fields: [model], references: [name], onDelete: SetNull)

  @@index([status])
  @@index([ownerId])
}

/// Knowledge an agent carries (menu, policies, FAQ). Included in its skill.
model ContextNote {
  agentId   String
  slug      String
  title     String
  body      String
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, slug])
}

/// A connection to an external system. Actions are declarative (see ConnectorActionSchema).
/// An LLM an owner added: provider + model id, API key encrypted. Named `<owner handle>-<name>`.
model AiModel {
  name          String   @id
  title         String
  /// gateway | openai | anthropic | google | openrouter | custom (check constraint in the Supabase schema)
  provider      String
  modelId       String
  baseUrl       String?
  keyCiphertext String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agents  Agent[]

  @@index([ownerId])
}

model Connector {
  /// `<owner handle>-<name>`
  name        String   @id
  title       String
  description String
  hosts       String[]
  /// Secret NAMES the actions reference. Values live encrypted in ConnectorSecret.
  secrets     String[]
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  secretValues ConnectorSecret[]
  agents       AgentConnector[]

  @@index([ownerId])
}

/// AES-256-GCM ciphertext (key: CONNECTOR_SECRETS_KEY). Never returned to callers.
model ConnectorSecret {
  connectorName String
  name          String
  ciphertext    String
  updatedAt     DateTime @updatedAt

  connector Connector @relation(fields: [connectorName], references: [name], onDelete: Cascade)

  @@id([connectorName, name])
}

/// Scope: which connector an agent may use, and which actions (empty = all).
model AgentConnector {
  agentId       String
  connectorName String
  actions       String[]

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connector Connector @relation(fields: [connectorName], references: [name], onDelete: Cascade)

  @@id([agentId, connectorName])
}

/// A data table an agent keeps (reservations, leads, outputs). Rows live in TableRow.
model AgentTable {
  agentId      String
  name         String
  title        String
  /// Markdown: what the table is for and how the agent should use it. Included in the skill.
  context      String   @default("")
  /// Column definitions (see TableColumnSchema).
  columns      Json     @default("[]")
  /// none | insert | own | read | write (check constraint in the Supabase schema)
  callerAccess String   @default("own")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, name])
}

/// One row of an agent's table. No FK to AgentTable: the built-in `outputs` table is virtual until customised.
model TableRow {
  id        String   @id @default(uuid())
  agentId   String
  tableName String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy String?
  creator   User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([agentId, tableName, createdAt])
}

/// When a scheduled agent runs by itself (cron in `timezone`) and what it does each time.
model AgentSchedule {
  id         String    @id @default(uuid())
  agentId    String
  task       String
  cron       String
  timezone   String    @default("UTC")
  enabled    Boolean   @default(true)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  /// ok | error
  lastStatus String?
  lastResult String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([agentId])
}

/// Something an agent charges for. amount is in the currency's smallest unit.
model Price {
  agentId     String
  name        String
  title       String
  description String   @default("")
  amount      Int
  currency    String
  updatedAt   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, name])
}

/// A Stripe Checkout link for one price, paid out to the agent owner (destination charge).
model Payment {
  id              String    @id @default(uuid())
  price           String
  amount          Int
  currency        String
  note            String    @default("")
  stripeSessionId String    @unique
  url             String
  /// open | paid | expired (check constraint in the Supabase schema)
  status          String    @default("open")
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  payerId String?
  payer   User?   @relation(fields: [payerId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([payerId])
}

model AccessRequest {
  id        String       @id @default(uuid())
  message   String       @default("")
  status    AccessStatus @default(pending)
  createdAt DateTime     @default(now())
  decidedAt DateTime?

  agentId     String
  agent       Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([requesterId])
}

/// Pending CLI sign-in (device flow). The device code is stored only as a sha256 hash.
model DeviceLogin {
  deviceCodeHash String   @id
  userCode       String   @unique
  /// pending | approved | denied (check constraint in the Supabase schema)
  status         String   @default("pending")
  clientName     String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bottleneck {
  id              String   @id @default(uuid())
  role            String
  description     String
  tools           String[]
  hoursPerWeek    Float?
  matchedAgentIds String[]
  createdAt       DateTime @default(now())
}
