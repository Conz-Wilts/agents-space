# Copy to .env.local at the repo root — both apps and the Prisma CLI read it.

# Supabase Postgres (Project → Connect → ORMs → Prisma).
# Pooled connection (port 6543, transaction mode) — used by the apps at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432) — used by `pnpm db:push` / `db:migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Without DATABASE_URL the apps fall back to an in-memory store (resets on restart, not shared).

# Encrypts connector secrets at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Changing it makes stored secrets unreadable — owners must set them again.
CONNECTOR_SECRETS_KEY=

# Public origin of apps/mcp, used for agent endpoints (<origin>/a/<id>/mcp). Defaults to the request origin.
PUBLIC_MCP_ORIGIN=
