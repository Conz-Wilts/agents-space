# Copy to .env.local at the repo root — both apps and the Prisma CLI read it.

# Supabase Auth — Google sign-in for the web AND OAuth for MCP clients. Project Settings → API.
# Dashboard setup (Google client id/secret go in Supabase, not here):
#  1. Authentication → Sign In / Providers → Google: paste the Google client id + secret.
#     In Google Cloud, add https://<project-ref>.supabase.co/auth/v1/callback as a redirect URI.
#  2. Authentication → URL Configuration: Site URL = web origin; add <web origin>/auth/callback to Redirect URLs.
#  3. Authentication → OAuth Server: enable, Authorization Path = /oauth/consent, allow dynamic client registration.
# With these set, the main MCP (/mcp) requires sign-in; without them it stays open (local dev).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Postgres (Project → Connect → ORMs → Prisma).
# Pooled connection (port 6543, transaction mode) — used by the apps at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432) — used by `pnpm db:push` / `db:migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Without DATABASE_URL the apps fall back to an in-memory store (resets on restart, not shared).

# Encrypts connector secrets at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Changing it makes stored secrets unreadable — owners must set them again.
CONNECTOR_SECRETS_KEY=

# Scheduled agents (mode "scheduled"). Vercel Cron calls /api/cron/schedules with Bearer $CRON_SECRET.
# Runs use the Vercel AI Gateway: AI_GATEWAY_API_KEY locally; on Vercel, OIDC works without it.
CRON_SECRET=
AI_GATEWAY_API_KEY=
# Optional, default anthropic/claude-sonnet-5.5
SCHEDULE_MODEL=

# Stripe platform account (Connect must be enabled). Owners connect their own Express accounts with
# enable_payments; callers pay through Checkout and the money is transferred to the owner. Unset = payments off.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Public origin of apps/mcp, used for agent endpoints (<origin>/a/<id>/mcp). Defaults to the request origin.
PUBLIC_MCP_ORIGIN=

# Public origins the apps link to each other with.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=http://localhost:3001/mcp

# Composio apps (Gmail, Slack, GitHub, ... — composio.dev). One platform key, server-side only, on
# both web and mcp. Each user connects their own accounts via OAuth; nobody else sees this key.
COMPOSIO_API_KEY=

# Supabase Storage bucket for profile icons (Google pictures copied on sign-in, shown in the directory).
# Defaults to directory-profile-icons. Uploads use the signed-in user's session (migration profile_icons).
NEXT_PUBLIC_PROFILE_ICONS_KEY=directory-profile-icons
