{
  "name": "agents-space",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mcp": "pnpm --filter mcp dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @agents-space/core db:generate",
    "db:push": "pnpm --filter @agents-space/core db:push",
    "db:migrate": "pnpm --filter @agents-space/core db:migrate",
    "db:deploy": "pnpm --filter @agents-space/core db:deploy",
    "db:seed": "pnpm --filter @agents-space/core db:seed"
  },
  "devDependencies": {
    "supabase": "^2.119.0",
    "turbo": "^2"
  }
}
